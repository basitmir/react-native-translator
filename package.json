{
  "name": "react-native-translator",
  "title": "React Native Translator",
  "version": "2.1.0",
  "description": "Free translate component & hook",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/"
  ],
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "lint": "eslint src --fix",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "fix": "yarn lint && yarn format",
    "test": "jest --watch",
    "lint:ci": "eslint src",
    "test:ci": "jest --coverage",
    "check-availability": "tsx src/check-availability.ts"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/koreanthinker/react-native-translator"
  },
  "keywords": [
    "react-native-translator",
    "react-native-translate",
    "react-native",
    "react native",
    "translate",
    "translator"
  ],
  "author": {
    "name": "KoreanThinker",
    "email": "koreanthinker@gmail.com"
  },
  "license": "MIT",
  "licenseFilename": "LICENSE",
  "readmeFilename": "README.md",
  "peerDependencies": {
    "react-native-webview": "*"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/runtime": "^7.29.7",
    "@react-native/babel-preset": "^0.80.3",
    "@react-native/eslint-config": "^0.74.89",
    "@react-native/typescript-config": "^0.74.89",
    "@testing-library/react-native": "^13.3.3",
    "@tsconfig/react-native": "^3.0.9",
    "@types/jest": "^29.5.14",
    "@types/lodash": "^4.17.24",
    "@types/react": "^19.2.17",
    "eslint": "^8.57.1",
    "eslint-plugin-testing-library": "^6.5.0",
    "jest": "^29.7.0",
    "metro-react-native-babel-preset": "^0.77.0",
    "prettier": "2.8.8",
    "puppeteer": "^24.43.1",
    "react": "^19.2.7",
    "react-native": "^0.80.3",
    "react-native-webview": "^13.16.1",
    "react-test-renderer": "^19.2.7",
    "ts-node": "^10.9.2",
    "tsx": "^4.22.4",
    "typescript": "5.1.5"
  },
  "dependencies": {
    "lodash": "^4.18.1"
  },
  "packageManager": "yarn@4.12.0+sha512.f45ab632439a67f8bc759bf32ead036a1f413287b9042726b7cc4818b7b49e14e9423ba49b18f9e06ea4941c1ad062385b1d8760a8d5091a1a31e5f6219afca8"
}
